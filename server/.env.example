# DashScope / 通义千问 API Key
DASHSCOPE_API_KEY=your-dashscope-api-key

# SQLite 数据库路径（可选，默认 ./data/interview.db）
DB_PATH=./data/interview.db

# 向量库路径
VECTORS_PATH=./data/vectors.json

# Rerank 模型配置（Embedding 粗排 + Rerank 精排，显著提升 RAG 效果）
# 默认开启；设为 false 可关闭，仅使用 Embedding 相似度排序
RERANK_ENABLED=true
# DashScope 兼容模式支持的 rerank 模型：gte-rerank / bge-reranker / gte-rerank-v2
RERANK_MODEL=gte-rerank
# 粗排阶段取前 N 条送入 Rerank 模型（默认 20）
RERANK_INITIAL_K=20
# Rerank 精排后取前 N 条（默认 5，最终按调用方 topK 截断）
RERANK_TOP_K=5
# Rerank API 端点（与 LLM 共用 DashScope 兼容模式）
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 阿里云智能语音交互（ASR + TTS）
# 1. 登录阿里云控制台 https://nls-portal.console.aliyun.com/applist 创建项目，获取 Appkey
# 2. 在 RAM 访问控制获取 AccessKey ID 和 AccessKey Secret
ALIYUN_AK_ID=your-aliyun-access-key-id
ALIYUN_AK_SECRET=your-aliyun-access-key-secret
ALIYUN_NLS_APPKEY=your-nls-appkey

# 语音功能 Mock 开关
# 设置为 true 时，ASR 返回固定文本，TTS 返回静音音频，用于本地无阿里云账号调试
SPEECH_MOCK=false

# 面试官访问控制
# 是否开启访问控制；设置为 true 时强制开启，false 时强制关闭。
# 未配置时，若配置了 ACCESS_EMAIL_DOMAINS 则自动开启，否则关闭。
ACCESS_CONTROL_ENABLED=true

# 邮箱域名白名单（邮箱验证方式使用），逗号分隔
ACCESS_EMAIL_DOMAINS=alibaba-inc.com,tencent.com,bytedance.com,meituan.com,baidu.com,jd.com,xiaomi.com,netease.com,huawei.com,antgroup.com

# 访问控制 Mock 开关（仅邮箱验证方式有效）
# 设置为 true 时，不发真实邮件，验证码直接打印在服务端日志
ACCESS_MOCK=true

# SMTP 邮件配置（ACCESS_MOCK=false 时生效）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=your-email@example.com
