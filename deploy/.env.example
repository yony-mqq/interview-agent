# 阿里云 OSS 上传凭证
# 复制本文件为 deploy/.env，填入你的真实凭证
# deploy/.env 已被 .gitignore 忽略，不会提交到 git

# -------- OSS 配置 --------
OSS_ACCESS_KEY_ID=你的阿里云AccessKeyID
OSS_ACCESS_KEY_SECRET=你的阿里云AccessKeySecret

# -------- 轻量服务器配置 --------
SERVER_HOST=你的轻量服务器IP
SERVER_USER=root
SERVER_PORT=22
# 如使用密钥登录而非密码，填写私钥路径（留空则使用密码/默认密钥）
SERVER_KEY_PATH=
